# ==============================================================================
# Attendance-Tracker Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
# Prisma connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_tracker?schema=public"

# Meta WhatsApp Cloud API Credentials
META_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
META_VERIFY_TOKEN="your_custom_webhook_verify_token_here"
META_PHONE_NUMBER_ID="100000000000000"
META_WHATSAPP_API_VERSION="v20.0"

# AI Parser (Google Gemini / OpenAI)
# Provider option: "gemini" or "openai"
LLM_PROVIDER="gemini"
LLM_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Model defaults: gemini-1.5-flash / gemini-2.0-flash / gpt-4o-mini
LLM_MODEL="gemini-1.5-flash"

# Backend FastAPI Settings
API_V1_STR="/api/v1"
PROJECT_NAME="Attendance & Task Tracker"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ENVIRONMENT="development"
SECRET_KEY="generate_a_random_32_byte_hex_secret_key_here"

# Frontend Next.js Settings
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
