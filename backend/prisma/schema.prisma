// Prisma Schema for WhatsApp Task Tracker
// Clean 3-entity schema: departments, employees, task_items

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider                    = "prisma-client-py"
  recursive_type_depth        = 5
  interface                   = "asyncio"
  enable_experimental_decimal = true
}

// -----------------------------------------------------------------------------
// 1. Departments Table
// -----------------------------------------------------------------------------
model Department {
  id        String     @id @default(dbgenerated("gen_random_uuid()"))
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")

  // Relations
  employees Employee[]

  @@map("departments")
}

// -----------------------------------------------------------------------------
// 2. Employees Table
// -----------------------------------------------------------------------------
model Employee {
  id                String      @id @default(dbgenerated("gen_random_uuid()"))
  employeeCode      String      @unique @map("employee_code")
  fullName          String      @map("full_name")
  phoneNumber       String      @unique @map("phone_number")
  departmentId      String?     @map("department_id")
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType    String      @default("FULL_TIME") @map("employment_type")
  monthlyBaseSalary Decimal     @default(0.00) @map("monthly_base_salary") @db.Decimal(12, 2)
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at")

  // Relations
  taskItems TaskItem[]

  @@index([phoneNumber])
  @@index([departmentId])
  @@index([isActive])
  @@map("employees")
}

// -----------------------------------------------------------------------------
// 3. Task Items Table
// -----------------------------------------------------------------------------
model TaskItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskDescription String   @map("task_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([createdAt])
  @@index([employeeId, createdAt])
  @@map("task_items")
}
