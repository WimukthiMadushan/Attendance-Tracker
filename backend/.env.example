# Backend specific environment variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_tracker?schema=public"

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
META_VERIFY_TOKEN="your_custom_webhook_verify_token_here"
META_PHONE_NUMBER_ID="100000000000000"
META_WHATSAPP_API_VERSION="v20.0"

# LLM Configuration
LLM_PROVIDER="gemini" # or "openai"
LLM_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_MODEL="gemini-1.5-flash"

# Application Settings
API_V1_STR="/api/v1"
PROJECT_NAME="Attendance & Task Tracker Backend"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ENVIRONMENT="development"
SECRET_KEY="replace_with_a_secure_random_key"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
